# AI Brain example environment.
# Copy to .env on the target host and replace every CHANGEME value.
# Do not commit .env or real secrets.

COMPOSE_PROJECT_NAME=aibrain

# Public hostnames
MAIN_DOMAIN=brain.cryptocomputer.ca
COUCHDB_DOMAIN=couchdb.brain.cryptocomputer.ca
OBSIDIAN_DOMAIN=obsidian.brain.cryptocomputer.ca

# Service ports bound to localhost for Nginx reverse proxying.
COUCHDB_BIND=127.0.0.1
COUCHDB_PORT=5984
OBSIDIAN_BIND=127.0.0.1
OBSIDIAN_PORT=8080
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434

# CouchDB admin credentials for Obsidian LiveSync.
COUCHDB_USER=admin
COUCHDB_PASSWORD=CHANGEME_generate_a_long_random_password
COUCHDB_SECRET=CHANGEME_generate_a_long_random_cookie_secret

# Obsidian browser service.
# obsidian-remote supports password protection via the container's web auth.
OBSIDIAN_PASSWORD=CHANGEME_generate_a_long_random_password

# Runtime behavior
TZ=America/Vancouver
PUID=1000
PGID=1000

# Ollama model cache volume is external and persistent.
OLLAMA_KEEP_ALIVE=24h
