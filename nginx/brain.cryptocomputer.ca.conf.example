# Example Nginx site config for AI Brain.
# Install under /etc/nginx/sites-available/ on the epyc host, then symlink to sites-enabled.
# Replace certificate paths if Certbot creates different names.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name brain.cryptocomputer.ca couchdb.brain.cryptocomputer.ca obsidian.brain.cryptocomputer.ca;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name brain.cryptocomputer.ca;

    ssl_certificate /etc/letsencrypt/live/brain.cryptocomputer.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brain.cryptocomputer.ca/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer-when-downgrade always;

    location / {
        return 200 "AI Brain origin is online.\n";
        add_header Content-Type text/plain;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name couchdb.brain.cryptocomputer.ca;

    ssl_certificate /etc/letsencrypt/live/brain.cryptocomputer.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brain.cryptocomputer.ca/privkey.pem;

    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:5984;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name obsidian.brain.cryptocomputer.ca;

    ssl_certificate /etc/letsencrypt/live/brain.cryptocomputer.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brain.cryptocomputer.ca/privkey.pem;

    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
